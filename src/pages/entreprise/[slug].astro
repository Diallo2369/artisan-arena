---
import Base from "../../layouts/Base.astro";
import { renderFiche, seo } from "../../lib/core.js";
import { load, entOf } from "../../lib/data.js";
import { SITE_URL } from "../../lib/site.js";

export function getStaticPaths() {
  const { ent } = load();
  const all = Object.values(ent);
  const lim = Number(process.env.LIMIT_PAGES || 0);
  return (lim ? all.slice(0, lim * 4) : all).map((e) => ({ params: { slug: e.slug }, props: { id: e.id } }));
}
const { id } = Astro.props;
const s = load();
const e = s.ent[id];
const dep = e.dep ? s.deps[e.dep] : null;
// d'autres entreprises de la même commune, qualifiées pour au moins un des mêmes travaux
const c = e.c ? s.communes[e.c] : null;
const near = c ? entOf(c.ids).filter((x) => x.id !== id && !x.bad && x.t.some((t) => e.t.includes(t))).slice(0, 5) : [];
const m = seo("fiche", { e });
const main = e.est[0];
const jsonld = {
  "@context": "https://schema.org", "@type": "HomeAndConstructionBusiness", name: e.nom, identifier: e.id,
  address: { "@type": "PostalAddress", streetAddress: main.adr, postalCode: main.cp, addressLocality: main.v, addressCountry: "FR" },
  ...(main.tel ? { telephone: main.tel.replace(/ /g, "") } : {}),
  ...(main.geo ? { geo: { "@type": "GeoCoordinates", latitude: main.geo[0], longitude: main.geo[1] } } : {}),
  ...(SITE_URL ? { url: SITE_URL + Astro.url.pathname } : {}),
};
---
<Base title={m.title} description={m.desc} page="fiche" jsonld={jsonld} noindex={e.ni}>
  <Fragment set:html={renderFiche({ e, dep, near })} />
</Base>
