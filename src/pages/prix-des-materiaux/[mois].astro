---
import Base from "../../layouts/Base.astro";
import { snapshots, renderArticle, article, prixUrl } from "../../lib/prix.js";
import { SITE_NAME, SITE_URL } from "../../lib/site.js";

export function getStaticPaths() {
  const all = snapshots();
  return all.map((snap, i) => ({
    params: { mois: prixUrl(snap.mois).split("/")[2] },
    props: { snap, prev: all[i - 1]?.mois, next: all[i + 1]?.mois },
  }));
}
const { snap, prev, next } = Astro.props;
const A = article(snap);
const desc = A.lede.length > 158 ? A.lede.slice(0, A.lede.lastIndexOf(" ", 155)) + "…" : A.lede;
const jsonld = { "@context": "https://schema.org", "@type": "Article", headline: A.title, datePublished: A.fige, dateModified: A.fige, inLanguage: "fr",
  publisher: { "@type": "Organization", name: SITE_NAME }, ...(SITE_URL ? { mainEntityOfPage: SITE_URL + prixUrl(snap.mois) } : {}) };
---
<Base title={A.title} description={desc} page="prix" jsonld={jsonld}>
  <Fragment set:html={renderArticle(snap, { prev, next })} />
</Base>
