---
import "@fontsource-variable/ibm-plex-sans/index.css";
import "../styles/site.css";
import { SITE_NAME, SITE_URL, INDEXABLE, CONTACT, ANALYTICS_TOKEN } from "../lib/site.js";
import fs from "node:fs";

const { title, description, page, noindex = false, jsonld = null } = Astro.props;
// image de partage : seulement si public/og.png a été produite (gabarit : scripts/og/og.html)
const ogImage = SITE_URL && fs.existsSync("public/og.png") ? SITE_URL + "/og.png" : "";
const canonical = SITE_URL ? SITE_URL + Astro.url.pathname : null;
const fullTitle = page === "home" ? title : `${title} | ${SITE_NAME}`;
const nav = [["avant", "/avant-de-signer/", "Avant de signer"], ["about", "/a-propos/", "À propos"]];
const home = page === "home";
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {(!INDEXABLE || noindex) && <meta name="robots" content="noindex" />}
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  {ogImage && <meta property="og:image:width" content="1200" />}
  {ogImage && <meta property="og:image:height" content="630" />}
  <meta property="og:locale" content="fr_FR" />
  <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
  <meta name="theme-color" content="#2342C8" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body data-page={page}>
  <a class="skip" href="#app">Aller au contenu</a>
  <header class:list={["top", { "top-home": home }]}>
    <div class="wrap top-in">
      <a class="logo" href="/" aria-label="Artisan Arena, accueil">
        <span class="logo-i" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11 12 4l9 7"/><path d="M6 10v10h12V10"/></svg></span>
        <span class="logo-t">Artisan</span><span class="logo-ar">Arena</span>
      </a>
      {!home && (
        <form class="top-search" role="search" action="/recherche/" method="get">
          <label for="rs-q" class="sr">Nom, métier ou ville</label>
          <input id="rs-q" name="q" type="search" autocomplete="off" enterkeyhint="search" placeholder="plombier Aurillac, Martin couvreur…" />
          <button type="submit" class="btn dark">Trouver</button>
        </form>
      )}
      <nav class="top-nav" aria-label="Menu principal">
        {nav.map(([k, href, label]) => <a href={href} aria-current={k === page ? "page" : undefined}>{label}</a>)}
      </nav>
    </div>
  </header>
  <main id="app" tabindex="-1"><slot /></main>
  <footer class="foot">
    <div class="wrap">
      <div class="foot-cols">
        <div>
          <a class="logo" href="/"><span class="logo-i" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11 12 4l9 7"/><path d="M6 10v10h12V10"/></svg></span><span class="logo-t">Artisan</span><span class="logo-ar">Arena</span></a>
          <p>Juste le bon artisan près de chez vous. Tous les artisans du bâtiment, d'après l'annuaire officiel des entreprises, avec leur ancienneté, leurs procédures collectives et leurs comptes.</p>
        </div>
        <nav aria-label="Pied de page"><a href="/">Rechercher</a><a href="/avant-de-signer/">Avant de signer</a><a href="/a-propos/">À propos</a><a href="/mentions-legales/">Mentions légales</a><a href="/confidentialite/">Confidentialité</a></nav>
      </div>
      <p class="foot-src">Données publiques lues en direct : Annuaire des entreprises (INSEE, Sirene), BODACC, INPI, ADEME. Aucune inscription, aucun cookie, aucun classement payé. Contact : <span class="sel">{CONTACT}</span></p>
      <p class="foot-fam">Les sites Arena : <a href="https://ehpadarena.fr/">EHPAD Arena</a> · <a href="https://argilearena.fr/">Argile Arena</a> · <a href="https://eauarena.fr/">Eau Arena</a> · <a href="https://scolarena.fr/">Scol Arena</a></p>
    </div>
  </footer>
  <script src="../scripts/app.js"></script>
  {INDEXABLE && ANALYTICS_TOKEN && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: ANALYTICS_TOKEN })}></script>}
</body>
</html>
